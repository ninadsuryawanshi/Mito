# ─────────────────────────────────────────────────────────────────────────────
# Mito — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# .env*.local is excluded via .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
# NEXT_PUBLIC_ prefix = safe to expose to the browser (access controlled by RLS)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ⚠ SERVER ONLY — this key bypasses Row-Level Security.
# Never use NEXT_PUBLIC_ prefix here. Never log or expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ─── AI APIs ──────────────────────────────────────────────────────────────────
# ⚠ SERVER ONLY — used exclusively in API routes, never in client code.

# Google Gemini (primary AI model)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your-gemini-api-key

# Groq (fallback AI model — activated if Gemini fails)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...your-groq-api-key

# ─── Application ──────────────────────────────────────────────────────────────
# Set to your production domain when deploying (e.g. https://mitohealth.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Web Push / PWA Notifications ─────────────────────────────────────────────
# Generate a VAPID key pair with: npx web-push generate-vapid-keys

# Public key — MUST be NEXT_PUBLIC_ so the browser can create a push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...your-vapid-public-key

# ⚠ SERVER ONLY — signs outgoing push payloads. Exposure allows notification spoofing.
VAPID_PRIVATE_KEY=c...your-vapid-private-key

# Contact email reported to the push service provider (required by Web Push spec)
VAPID_SUBJECT=mailto:support@yourdomain.com
